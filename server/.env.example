# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/campusfix?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/campusfix

# JWT Authentication Secret & Expiration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRE=30d

# Client Application URL (For CORS configuration)
CLIENT_URL=http://localhost:5173

# Cloudinary Storage Configuration
# Sign up at https://cloudinary.com and get credentials from the dashboard
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional Email Configuration (Nodemailer SMTP)
# If unconfigured, the application gracefully operates without crashing
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
EMAIL_FROM=CampusFix Facilities Desk <no-reply@campusfix.edu>

